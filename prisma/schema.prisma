// Dynamic Wizard Questions - domain data model.
// SQLite (v1 single-user local, no concurrent-write pressure).
// JSON-shaped fields (persona, rubric, matched/missing/etc.) are stored as
// TEXT holding JSON, because SQLite has no native JSON/array column and this
// stays portable and debuggable.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Session {
  id             String        @id @default(cuid())
  role           String
  specialization String? // the chosen stack/focus (e.g. "Python / Data + ML"); scopes the topics
  candidateName  String? // optional name or id shown on the report
  persona        String? // JSON: { background?, years? }
  language       String        @default("en") // "en" | "ar"
  status     String            @default("active") // active | done | abandoned
  // Stamped once at start and never changed for this session. The assessment mode
  // and length must NOT be read from module-level env at submit time: an env flip
  // (or a process restart on a new default) would otherwise change the format and
  // the total length of a run already in progress.
  mode         String          @default("mcq") // "mcq" | "text"
  maxQuestions Int             @default(25)
  blueprintPending Boolean      @default(false) // live path: real topics still being built in the background
  finalScore Int? // 0..1000, set when done
  reportJson String? // full SessionReport JSON, persisted for the report permalink
  startedAt  DateTime          @default(now())
  finishedAt DateTime?

  topics        Topic[]
  questions     Question[]
  snapshots     AbilitySnapshot[]
  bankQuestions BankQuestion[]
}

model Topic {
  id            String  @id @default(cuid())
  sessionId     String
  session       Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name             String
  // Canonical tag from a fixed vocabulary, used to key learning resources. The
  // display name is free-text agent output and differs per language, so it can
  // never be a lookup key.
  tag              String?
  order            Int // stable display order
  importance       Int     @map("weight") // this topic's share of the 1000-point total
  theta            Float // live ability estimate, scale 1..10
  sigma            Float // uncertainty (std dev of the estimate)
  startLevel       Float   @map("firstPickPrior") // starting level guess 1..10, aims only the first question
  points           Int     @default(0) // importance * theta/10, filled at scoring
  questionsAsked   Int     @default(0)
  answeredCount    Int     @default(0) // graded observations (drives resume + stops)
  consecutiveStrong Int    @default(0) // strong-answer streak for the ceiling probe
  converged        Boolean @default(false)

  questions     Question[]
  snapshots     AbilitySnapshot[]
  bankQuestions BankQuestion[]

  @@index([sessionId])
}

model Question {
  id         String   @id @default(cuid())
  sessionId  String
  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  topicId    String
  topic      Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  order      Int // global question order in the session
  difficulty Int // 1..10 target band the question probes
  text       String
  rubric     String // JSON: { points: string[], gold: string, maxScore: number, level: number }
  maxScore   Int      @default(100)
  format       String  @default("text") // "text" | "mcq"
  optionsJson  String? // JSON string[] of options, mcq only
  correctIndex Int? // 0-based correct option, mcq only (never sent to the client)
  // The engine's decision for this question, PERSISTED rather than re-derived.
  // getSessionState used to rebuild the ask flags by re-running decide() over
  // topic state, which only holds while every input to that decision is itself
  // persisted. Intent selection has a seeded tie-break and reads an evidence
  // ledger, so the decision is stored here and read back verbatim on resume.
  intent       String? // the code-chosen question intent, text mode
  affordsJson  String? // JSON string[]: which signal axes this question can elicit
  targetLevel  Float? // the 1..10 level aimed at (difficulty stays the integer the UI labels)
  createdAt  DateTime @default(now())

  answer Answer?

  // One question per slot. continueSession and getSessionState both look up "the
  // unanswered question at order = answered + 1"; without this, two rows at the
  // same order would let resume serve a different question than submit graded.
  @@unique([sessionId, order])
  @@index([sessionId])
  @@index([topicId])
}

model Answer {
  id          String   @id @default(cuid())
  questionId  String   @unique
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text        String
  submittedAt DateTime @default(now())

  evaluation Evaluation?
}

model Evaluation {
  id                      String   @id @default(cuid())
  answerId                String   @unique
  answer                  Answer   @relation(fields: [answerId], references: [id], onDelete: Cascade)
  score                   Int // 0..100 raw grade
  demonstratedLevel       Int // 1..10 level the answer demonstrates
  llmConfidence           Float // grader self-reported 0..1 (display/log ONLY, never in math)
  deterministicConfidence Float // the c value actually used by the engine
  matched                 String // JSON string[]
  missing                 String // JSON string[]
  misconceptions          String // JSON string[]
  feedback                String
  // Text mode. The band is the read of THIS answer (1..6); observations are the
  // quote-verified signals it was derived from, and the axis profile is what the
  // report's "how you think" view is built from. JSON for the same reason the
  // fields above are: SQLite has no array column.
  band                    Int?
  observationsJson        String?
  axisProfileJson         String?
  createdAt               DateTime @default(now())
}

// One row per engine update: drives the level-over-time curve.
model AbilitySnapshot {
  id        String   @id @default(cuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  topicId   String
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  order     Int // global step order
  theta     Float
  sigma     Float
  createdAt DateTime @default(now())

  @@index([sessionId])
}

// Pre-generated pool of multiple-choice questions, built in one batch at session
// start so serving an MCQ round is pure DB work (zero AI on the hot path). A row
// is popped (used=true) and copied into a Question when it is actually asked.
model BankQuestion {
  id           String   @id @default(cuid())
  sessionId    String
  session      Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  topicId      String
  topic        Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  level        Int // 1..10 band this MCQ targets
  stem         String
  optionsJson  String // JSON string[] of options
  correctIndex Int // 0-based correct option
  used         Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([sessionId])
  @@index([topicId])
}

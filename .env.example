# Copy to .env and adjust. No ANTHROPIC_API_KEY is used: agents run on the
# personal Claude subscription via the local `claude` CLI and force the key unset.

# Prisma / SQLite (resolves relative to the project root).
DATABASE_URL="file:./dev.db"

# Path to the local `claude` CLI the Agent SDK spawns. Set to your install path
# so the child-process spawn never ENOENTs from inside a bundled Next route.
CLAUDE_CLI_PATH="C:\\Users\\you\\.local\\bin\\claude.exe"

# Langfuse (OPTIONAL, non-blocking). Leave blank to run with tracing off.
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_BASEURL="http://localhost:3000"

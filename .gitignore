# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# local agent/tooling state (session settings, browser profiles), never commit
.claude/
.playwright-mcp/

# generated presentation binaries (regenerable, keep the repo lean)
docs/*.pptx
docs/*.pdf

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local sqlite database (holds session data + user answers, never commit)
dev.db
dev.db-journal
*.db

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# local validity-gate run output (evidence, not source)
.gate/
